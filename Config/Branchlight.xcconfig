// Branchlight shared build configuration.
//
// Do not commit a personal Team ID. Local development signing belongs in
// Config/Branchlight.local.xcconfig, which is intentionally gitignored.
//
// XcodeGen regenerates Branchlight.xcodeproj from project.yml, so keeping the
// Team selection only in the generated project is not durable.

CODE_SIGN_STYLE = Automatic
REGISTER_APP_GROUPS = YES

#include? "Branchlight.local.xcconfig"
